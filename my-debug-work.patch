+    pub static FAST_RECOVERY: OnceCell<usize> = OnceCell::new();
+    *FAST_RECOVERY.get_or_init(|| {
+        std::env::var(FAST_RECOVERY_INTERVAL).map_or(256, |s| s.parse().unwrap_or(256))
+    })
+}
